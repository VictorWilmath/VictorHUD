{
  "action_manifest_version": 0,
  "alias_info": {},
  "app_key": "victorwilmath.victorhud",
  "bindings": {
    "/actions/main": {
      "poses": [
        { "output": "/actions/main/in/pointer", "path": "/user/hand/left/pose/tip" },
        { "output": "/actions/main/in/pointer", "path": "/user/hand/right/pose/tip" }
      ],
      "haptics": [
        { "output": "/actions/main/out/haptic", "path": "/user/hand/left/output/haptic" },
        { "output": "/actions/main/out/haptic", "path": "/user/hand/right/output/haptic" }
      ],
      "sources": [
        { "path": "/user/hand/left/input/trigger", "mode": "trigger", "inputs": { "click": { "output": "/actions/main/in/click" } } },
        { "path": "/user/hand/right/input/trigger", "mode": "trigger", "inputs": { "click": { "output": "/actions/main/in/click" } } },
        { "path": "/user/hand/left/input/grip", "mode": "button", "inputs": { "click": { "output": "/actions/main/in/grab" } } },
        { "path": "/user/hand/right/input/grip", "mode": "button", "inputs": { "click": { "output": "/actions/main/in/grab" } } },
        { "path": "/user/hand/left/input/joystick", "mode": "joystick", "inputs": { "position": { "output": "/actions/main/in/scroll" } } },
        { "path": "/user/hand/right/input/joystick", "mode": "joystick", "inputs": { "position": { "output": "/actions/main/in/scroll" } } },
        { "path": "/user/hand/left/input/application_menu", "mode": "button", "inputs": { "click": { "output": "/actions/main/in/toggle_watch" } } },
        { "path": "/user/hand/right/input/application_menu", "mode": "button", "inputs": { "click": { "output": "/actions/main/in/toggle_watch" } } },
        { "path": "/user/hand/left/input/trackpad", "mode": "button", "inputs": { "click": { "output": "/actions/main/in/right_click" } } },
        { "path": "/user/hand/right/input/trackpad", "mode": "button", "inputs": { "click": { "output": "/actions/main/in/right_click" } } }
      ]
    }
  },
  "controller_type": "holographic_controller",
  "description": "VictorHUD defaults: trigger clicks, grip grabs panels, thumbstick scrolls, trackpad click right-clicks, menu shows the watch.",
  "name": "VictorHUD defaults"
}
